{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "nexvary/web-platform",
  "type": "project",
  "description": "NEXVARY secure web platform",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/fortify": "^1.37.2",
    "laravel/framework": "^13.17",
    "laravel/passkeys": "^0.2.1",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": ["@php artisan config:clear --ansi", "@php artisan test"],
    "lint:check": ["pint --parallel --test"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
