APP_NAME=NEXVARY
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
CACHE_STORE=database
QUEUE_CONNECTION=database
NEXVARY_ADMIN_PREFIX=secure-control
NEXVARY_AUTH_PREFIX=secure-access
NEXVARY_CSP_REPORT_ONLY=false
NEXVARY_VERSION=0.1.0-dev
NEXVARY_UPDATE_CHANNEL=stable
NEXVARY_UPDATE_MANIFEST_URL=
NEXVARY_UPDATE_ALLOWED_HOSTS=nexvary.com,www.nexvary.com
NEXVARY_UPDATE_TIMEOUT=20
NEXVARY_UPDATE_MAX_ARCHIVE_MB=200
